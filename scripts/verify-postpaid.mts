const oldEgressFunding=captureServiceFunding('egress-period',now);
db.prepare("INSERT INTO postpaid_meter(userId,kind,remainder,fundingJson) VALUES(?,'egress',?,?)").run('egress-period','966367641',JSON.stringify(oldEgressFunding));
reserveEgress('egress-period',{...base,eventId:'round-period',bytes:'3579140'});
const futureFunding=captureServiceFunding('egress-period',at(800));
db.prepare('UPDATE postpaid_egress SET fundingJson=? WHERE userId=?').run(JSON.stringify(futureFunding),'egress-period');
assert.equal(settleEgress('egress-period','round-period','3579140',true).chargedCents,1);
assert.equal((db.prepare("SELECT SUM(u.amountCents) n FROM subscription_usage u JOIN subscription_period p ON p.id=u.periodId WHERE p.userId='egress-period'").get() as {n:number}).n,1);
assert.equal(cloudState('egress-period').billing.debtCents,0);
console.log('egress cross-period fractional funding preserved');
// Full manifest completion is itself the executor's committed-metadata acknowledgement.
const {finishCleanup}=await import('../lib/postpaid');
