// First ACK evidence must precede the original deadline; retries never reset that decision.
const makeNoticeCase=(user:string)=>{
 accept(user,10);
 withTransaction(d=>spendCredits(d,{userId:user,amountCents:11,ledgerKind:'service_spend',funding:captureServiceFunding(user,now),delivered:true,nowIso:now}));
 const state=cloudState(user,now);
 return {id:state.cloudAccess.caseId!,remind:state.billing.remindAt!,deadline:state.billing.cleanupAt!};
};
const noticeTime=(c:{deadline:string},deltaMs:number)=>new Date(Date.parse(c.deadline)+deltaMs).toISOString();
const receiptRow=(user:string)=>getDb().prepare('SELECT notificationReceipt,firstAckAt,cleanupState FROM postpaid_case WHERE userId=? ORDER BY openedAt DESC LIMIT 1').get(user) as {notificationReceipt:string|null;firstAckAt:string|null;cleanupState:string};
const timely=makeNoticeCase('notice-timely'),timelyAck=noticeTime(timely,-3600000);
acknowledgeNotification('notice-timely',timely.id,'first',timelyAck);
assert.equal(cloudState('notice-timely',timely.deadline).cloudAccess.cleanupEligible,true);
acknowledgeNotification('notice-timely',timely.id,'retry',noticeTime(timely,3600000));
assert.deepEqual(receiptRow('notice-timely'),{notificationReceipt:'first',firstAckAt:timelyAck,cleanupState:'none'});
assert.equal(cloudState('notice-timely',noticeTime(timely,3600000)).cloudAccess.cleanupEligible,true);
for(const delta of [0,3600000]) {
 const user=`notice-late-${delta}`,c=makeNoticeCase(user),ackAt=noticeTime(c,delta);
 acknowledgeNotification(user,c.id,'first',ackAt);
 let state=cloudState(user,ackAt);
 assert.equal(state.cloudAccess.cleanupState,'review');assert.equal(state.cloudAccess.cleanupEligible,false);
 assert.equal(state.cloudAccess.frozen,false);assert.equal(state.cloudAccess.epoch,1);
 assert.equal(claimCleanup(user,c.id,1,'new',ackAt,{...binding,itemCount:1}).allowed,false);
 acknowledgeNotification(user,c.id,'retry',noticeTime(c,7200000));
 assert.deepEqual(receiptRow(user),{notificationReceipt:'first',firstAckAt:ackAt,cleanupState:'review'});
 // Review does not move the storage stop time or create another billing grace period.
 const end=noticeTime(c,86400000);
 recordStorage(user,{eventId:'late-notice-storage',epoch:1,from:now,to:end,storedBytes:'1073741824'},end);
 assert.equal(cloudState(user,end).billing.debtCents,14,'only original first 120 hours are billable');
 assert.equal(cloudState(user,end).billing.cleanupAt,c.deadline);
 withTransaction(d=>grantCredits(d,{userId:user,pool:'topup',amountCents:1,ledgerKind:'recharge',nowIso:now}));
 withTransaction(d=>registerCreditGrant(d,user,'renewed',100,now,at(720)));
 state=cloudState(user,end);
 assert.equal(state.cloudAccess.caseId,c.id);assert.equal(state.cloudAccess.cleanupEligible,false);assert.equal(state.cloudAccess.cleanupState,'review');
 assert.equal(state.billing.debtCents,13);
 withTransaction(d=>grantCredits(d,{userId:user,pool:'topup',amountCents:13,ledgerKind:'recharge',nowIso:now}));
 assert.equal(cloudState(user,end).cloudAccess.caseId,null);assert.equal(cloudState(user,end).billing.debtCents,0);
}
// Rebuild an actual v46 boundary, preserving legacy receipts and already-issued leases.
const unknown=makeNoticeCase('notice-legacy');
db.prepare('UPDATE postpaid_case SET notificationReceipt=? WHERE id=?').run('legacy-receipt',unknown.id);
const inFlight=makeNoticeCase('notice-in-flight');
acknowledgeNotification('notice-in-flight',inFlight.id,'receipt',inFlight.remind);
const inFlightClaim=claimCleanup('notice-in-flight',inFlight.id,1,'one',inFlight.deadline,binding);
assert.equal(inFlightClaim.allowed,true);
db.exec('ALTER TABLE postpaid_case DROP COLUMN firstAckAt');
db.exec('DROP TABLE postpaid_shadow_event; DROP TABLE postpaid_shadow_meter; DROP TABLE postpaid_shadow_unmapped');
db.exec('DROP TABLE bqt_settings; DROP TABLE bqt_settings_audit; DROP TABLE bqt_consume; DROP TABLE bqt_entitlement_snapshot');
db.prepare('DELETE FROM schema_version WHERE version>=47').run();
const {closeDb}=await import('../lib/db');closeDb();
const migrated=getDb();
assert.equal((migrated.prepare('SELECT MAX(version) v FROM schema_version').get() as {v:number}).v,51);
assert.equal(receiptRow('notice-legacy').cleanupState,'review');assert.equal(receiptRow('notice-legacy').firstAckAt,null);
acknowledgeNotification('notice-legacy',unknown.id,'retry',noticeTime(unknown,3600000));
assert.equal(receiptRow('notice-legacy').firstAckAt,null,'a retry cannot invent historical first-ACK evidence');
assert.equal(cloudState('notice-legacy',noticeTime(unknown,3600000)).cloudAccess.cleanupEligible,false);
assert.equal(claimCleanup('notice-legacy',unknown.id,1,'new',noticeTime(unknown,3600000),{...binding,itemCount:1}).allowed,false);
assert.equal(receiptRow('notice-in-flight').cleanupState,'deleting');
assert.equal(cloudState('notice-in-flight',inFlight.deadline).cloudAccess.frozen,true);
assert.equal(claimCleanup('notice-in-flight',inFlight.id,2,'one',noticeTime(inFlight,59000),binding).allowed,true,'signed lease remains valid');
assert.equal(claimCleanup('notice-in-flight',inFlight.id,2,'two',noticeTime(inFlight,59000),binding).allowed,false,'unknown old ACK cannot issue another permit');
assert.equal(claimCleanup('notice-in-flight',inFlight.id,2,'one',noticeTime(inFlight,60000),binding).allowed,false,'unknown old ACK cannot renew expired lease');
completeCleanup('notice-in-flight',inFlightClaim.claimId!,true);
assert.equal(claimCleanup('notice-in-flight',inFlight.id,2,'one',noticeTime(inFlight,61000),binding,true).completed,true,'exact completion recovery remains available');
closeDb();getDb();assert.equal(receiptRow('notice-legacy').firstAckAt,null,'reopening migration is idempotent');
console.log('timely/late ACK, immutable retries, repayment, original cutoff and v46 receipt/lease migration passed');
