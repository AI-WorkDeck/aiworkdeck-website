withTransaction(d=>spendCredits(d,{userId:'finished',amountCents:11,ledgerKind:'service_spend',funding:captureServiceFunding('finished'),delivered:true}));
const finishState=cloudState('finished'),finishAt=new Date(Date.parse(finishState.billing.cleanupAt!)+1).toISOString();
acknowledgeNotification('finished',finishState.cloudAccess.caseId!,'receipt',finishState.billing.remindAt!);
