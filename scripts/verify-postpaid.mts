assert.equal(cloudState('download').billing.reservedCreditCents,0);
accept('export',10);
withTransaction(d=>spendCredits(d,{userId:'export',amountCents:11,ledgerKind:'service_spend',funding:captureServiceFunding('export'),delivered:true}));
