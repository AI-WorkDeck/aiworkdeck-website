console.log('paid partial egress, replay fencing, zero-byte cancellation, free export cap passed');
// Historical subscription grants must not grant free capacity after entitlement revocation.
const provision=(user:string,start:string,end:string,entitlementEnd=end)=>{
 db.prepare('INSERT INTO pro_payment(outTradeNo,userId,plan,amountCents,periodStart,periodEnd,createdAt) VALUES(?,?,?,?,?,?,?)').run(user,user,'monthly',14900,start,end,start);
 db.prepare('INSERT INTO entitlements(userId,feature,orderId,createdAt,expiresAt) VALUES(?,?,?,?,?)').run(user,'pro',user,start,entitlementEnd);
};
acceptPostpaid('historical',POSTPAID_VERSION,now);provision('historical',now,at(720),at(360));
recordStorage('historical',{eventId:'whole',epoch:1,from:now,to:at(720),storedBytes:'3221225472'},at(720));
const historicalUsage=db.prepare("SELECT SUM(json_extract(meta,'$.billedCents')) n FROM wallet_ledger WHERE userId='historical' AND json_extract(meta,'$.service')='cloud_storage'").get() as {n:number};
assert.equal(historicalUsage.n,30,'3 GiB free before revocation; 3 GiB for remaining half month costs 30 cents');
// Cross-period metering settles against the period of use, not the delivery time of its report.
acceptPostpaid('period',POSTPAID_VERSION,now);provision('period',now,at(720));
recordStorage('period',{eventId:'first',epoch:1,from:now,to:at(720),storedBytes:'4294967296'},at(720));
assert.equal((db.prepare("SELECT SUM(u.amountCents) n FROM subscription_usage u JOIN subscription_period p ON p.id=u.periodId WHERE p.userId='period'").get() as {n:number}).n,20);
assert.equal(cloudState('period',at(720)).billing.debtCents,0);
// Clip a report at the deletion deadline and still advance the watermark past it.
accept('clip',10);
withTransaction(d=>spendCredits(d,{userId:'clip',amountCents:11,ledgerKind:'service_spend',funding:captureServiceFunding('clip'),delivered:true}));
const deadline=cloudState('clip').billing.cleanupAt!;
const endAfter=new Date(Date.parse(deadline)+86400000).toISOString();
recordStorage('clip',{eventId:'clip',epoch:1,from:now,to:endAfter,storedBytes:'1073741824'},endAfter);
assert.equal(cloudState('clip',endAfter).billing.storageMeteredThrough,endAfter);
const chargedBefore=cloudState('clip',endAfter).billing.debtCents;
recordStorage('clip',{eventId:'after',epoch:1,from:endAfter,to:new Date(Date.parse(endAfter)+86400000).toISOString(),storedBytes:'1073741824'},new Date(Date.parse(endAfter)+86400000).toISOString());
assert.equal(cloudState('clip',endAfter).billing.debtCents,chargedBefore);
assert.throws(()=>recordStorage('clip',{eventId:'bad',epoch:1,from:'bad',to:'bad',storedBytes:'1'}),/invalid_storage_event/);
console.log('storage historical rights, original funding periods, cutoff clipping and malformed dates passed');
const {reconcileCleanup,resumeCloud,acknowledgeCleanupReconciled}=await import('../lib/postpaid');
// A committed remote completion with a lost response must be recoverable without a second physical deletion.
const completedClaim=claimCleanup('a',s.cloudAccess.caseId!,2,'file',after(121),binding);
assert.equal(completedClaim.allowed,false);assert.equal(completedClaim.completed,true);
assert.equal(claimCleanup('a',s.cloudAccess.caseId!,2,'file',after(121),binding,true).completed,true,'receipt-only recovers completed deletion after payment');
assert.throws(()=>claimCleanup('a',s.cloudAccess.caseId!,2,'file',after(121),{...binding,manifestHash:'c'.repeat(64)}));
assert.equal(cloudState('a').cloudAccess.cleanupState,'deleting','repayment is not proof of full cleanup');
assert.throws(()=>resumeCloud('a',POSTPAID_VERSION),/cleanup_metadata_pending/);
assert.throws(()=>acknowledgeCleanupReconciled('a',s.cloudAccess.caseId!,2,'c'.repeat(64)),/cleanup_manifest_conflict/);
acknowledgeCleanupReconciled('a',s.cloudAccess.caseId!,2,binding.manifestHash);
assert.equal(cloudState('a').cloudAccess.cleanupState,'partial','unissued manifest objects are not declared deleted');
resumeCloud('a',POSTPAID_VERSION);assert.equal(cloudState('a').cloudAccess.epoch,3);
assert.throws(()=>claimCleanup('a',s.cloudAccess.caseId!,2,'file',after(121),binding));
// Expiry alone never means an issued destructive operation did not happen.
accept('cancel',10);
withTransaction(d=>spendCredits(d,{userId:'cancel',amountCents:11,ledgerKind:'service_spend',funding:captureServiceFunding('cancel'),delivered:true}));
const cancelState=cloudState('cancel'),cancelFuture=new Date(Date.parse(cancelState.billing.cleanupAt!)+1000).toISOString();
acknowledgeNotification('cancel',cancelState.cloudAccess.caseId!,'delivered',cancelState.billing.remindAt!);
const issued=claimCleanup('cancel',cancelState.cloudAccess.caseId!,1,'old-object',cancelFuture,{...binding,itemCount:1});
withTransaction(d=>grantCredits(d,{userId:'cancel',pool:'topup',amountCents:11,ledgerKind:'recharge'}));
assert.throws(()=>resumeCloud('cancel',POSTPAID_VERSION),/cleanup_incomplete/);
assert.throws(()=>acknowledgeCleanupReconciled('cancel',cancelState.cloudAccess.caseId!,2,binding.manifestHash),/cleanup_incomplete/);
const expired=new Date(Date.parse(cancelFuture)+61000).toISOString();
assert.throws(()=>reconcileCleanup('cancel',issued.claimId!,'not_executed','d'.repeat(64),expired),/manual_review/);
process.env.AWD_POSTPAID_RECONCILIATION_ENABLED='true';
reconcileCleanup('cancel',issued.claimId!,'not_executed','d'.repeat(64),expired);
assert.throws(()=>resumeCloud('cancel',POSTPAID_VERSION),/cleanup_metadata_pending/);
acknowledgeCleanupReconciled('cancel',cancelState.cloudAccess.caseId!,2,binding.manifestHash);
resumeCloud('cancel',POSTPAID_VERSION);assert.equal(cloudState('cancel').cloudAccess.frozen,false);
console.log('cleanup lost-receipt replay, immutable object binding, generation fence and evidence-gated cancellation passed');
// Egress fractions retain their original subscription period across later reservations.
