console.log('postpaid ledger, reservation, repayment, chargeback, cleanup and meter tests passed');
const {reserveEgress,settleEgress,egressQuote}=await import('../lib/postpaid-egress');
accept('download',1000);
const hash='f'.repeat(64),base={eventId:'dl1',epoch:1,resourceHash:hash,bytes:'1073741824'};
assert.equal(egressQuote(base.bytes).quoteCents,60);
reserveEgress('download',base);assert.equal(cloudState('download').billing.reservedCreditCents,60);
assert.equal(settleEgress('download','dl1','536870912',false).chargedCents,30);
assert.equal(settleEgress('download','dl1','536870912',false).chargedCents,30);
