import assert from 'node:assert/strict';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
const cwd = process.cwd();
const temp = fs.mkdtempSync(path.join(os.tmpdir(), 'awd-iap-sandbox-'));
process.chdir(temp);
process.env.APPSTORE_SANDBOX_ACCOUNT_IDS = 'review-a,review-b';
const mod = await import('../lib/appstore-sandbox-subscription');
let checks = 0;
const check = (run: () => void) => { run(); checks++; };
const a = mod.prepareSandboxSubscription('review-a'), b = mod.prepareSandboxSubscription('review-b');
check(() => assert.equal(mod.prepareSandboxSubscription('review-a').appAccountToken, a.appAccountToken));
check(() => assert.throws(() => mod.prepareSandboxSubscription('ordinary')));
const now = Date.now();
const tx = { environment: 'Sandbox', productId: a.productId, type: 'Auto-Renewable Subscription', inAppOwnershipType: 'PURCHASED',
  transactionId: 't1', originalTransactionId: 'o1', appAccountToken: a.appAccountToken, purchaseDate: now - 1000, expiresDate: now + 60000, signedDate: now } as Parameters<typeof mod.applySandboxSubscription>[0];
check(() => assert.throws(() => mod.applySandboxSubscription({...tx, environment: 'Production' as typeof tx.environment}, 'review-a')));
check(() => assert.throws(() => mod.applySandboxSubscription(tx, 'review-b')));
check(() => assert.equal(mod.applySandboxSubscription(tx, 'review-a').duplicate, false));
check(() => assert.equal(mod.applySandboxSubscription(tx, 'review-a').duplicate, true));
check(() => assert.equal(mod.sandboxSubscriptionSnapshot('review-a').active, true));
check(() => assert.equal(mod.sandboxSubscriptionSnapshot('review-a').availableCents, 0));
check(() => assert.equal(mod.sandboxSubscriptionSnapshot('review-a').periodId, null));
check(() => assert.throws(() => mod.applySandboxSubscription({...tx, transactionId:'t2', appAccountToken:b.appAccountToken}, 'review-b')));
check(() => assert.throws(() => mod.applySandboxSubscription(tx, 'review-a', {environment:'Production',originalTransactionId:'o1',productId:a.productId} as Parameters<typeof mod.applySandboxSubscription>[2])));
check(() => assert.throws(() => mod.applySandboxSubscription(tx, 'review-a', {environment:'Sandbox',originalTransactionId:'o1',productId:a.productId,appAccountToken:b.appAccountToken} as Parameters<typeof mod.applySandboxSubscription>[2])));
mod.applySandboxSubscription({...tx, revocationDate:now - 1, signedDate:now + 1}, 'review-a');
check(() => assert.equal(mod.sandboxSubscriptionSnapshot('review-a').active, false));
mod.applySandboxSubscription(tx, 'review-a');
check(() => assert.equal(mod.sandboxSubscriptionSnapshot('review-a').active, false));
mod.applySandboxSubscription({...tx, signedDate:now + 2}, 'review-a', undefined, true);
check(() => assert.equal(mod.sandboxSubscriptionSnapshot('review-a').active, true));
check(() => assert.equal(mod.sandboxSubscriptionSnapshot('review-a', now+60001).active, false));
const shared = '6f9619ff-8b86-4011-b42d-00c04fc964ff';
check(() => assert.equal(mod.prepareSandboxSubscription('review-a', shared.toUpperCase()).appAccountToken, shared));
check(() => assert.equal(mod.prepareSandboxSubscription('review-a').appAccountToken, shared));
check(() => assert.equal(mod.applySandboxSubscription({...tx, signedDate:now + 3}, 'review-a').userId, 'review-a'));
check(() => assert.equal(mod.sandboxMappedUserId(tx), 'review-a'));
check(() => assert.equal(mod.applySandboxSubscription({...tx, transactionId:'t3', appAccountToken:shared}, 'review-a').userId, 'review-a'));
check(() => assert.throws(() => mod.applySandboxSubscription({...tx, transactionId:'t4', originalTransactionId:'o4', appAccountToken:shared}, 'review-b')));
process.env.APPSTORE_SANDBOX_ACCOUNT_IDS = 'review-b';
check(() => assert.throws(() => mod.applySandboxSubscription(tx, 'review-a')));
check(() => assert.throws(() => mod.sandboxSubscriptionSnapshot('review-a')));
check(() => assert.deepEqual(fs.readdirSync('data').filter(f => !f.startsWith('appstore-sandbox.sqlite')), []));
process.chdir(cwd);
console.log(`Sandbox isolation: ${checks} checks passed; no production ledger created`);
